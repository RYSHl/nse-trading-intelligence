# NSE Trading Intelligence — Backend Environment Variables
# Safe Local Development Defaults (No secrets required)

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001

# Database: Local SQLite file. For PostgreSQL in production, set e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/nse_trading
DATABASE_URL=sqlite:///./nse_trading.db

DEFAULT_MARKET=NSE
TIMEZONE=Asia/Kolkata

# Market Data Feed:
# 'yahoo'  -> Historical research data with automatic retry and caching
# 'replay' -> Deterministic bar-by-bar market step simulator
MARKET_DATA_PROVIDER=yahoo
DATA_CACHE_TTL_SECONDS=300

# Zerodha Kite Connect:
# Strictly disabled for local development and backtesting.
# Real orders require explicit manual user approval in the terminal.
KITE_ENABLED=false
# KITE_API_KEY=
# KITE_API_SECRET=
